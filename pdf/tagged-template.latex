\ExplSyntaxOn
\sys_gset_rand_seed:n {$pdf-random-seed$}
\ExplSyntaxOff
$endif$
$document-metadata.latex()$
$passoptions.latex()$
\documentclass[
$for(babel-otherlangs)$
  $babel-otherlangs$,
$endfor$
$if(babel-lang)$
  $babel-lang$,
$endif$
$if(fontsize)$
  $fontsize$,
$endif$
$if(papersize)$
  $papersize$paper,
$endif$
$for(classoption)$
  $classoption$$sep$,
$endfor$
]{$documentclass$}
$if(beamerarticle)$
\usepackage{beamerarticle} % needs to be loaded first
$endif$
\usepackage{xcolor}
$if(geometry)$
\usepackage[$for(geometry)$$geometry$$sep$,$endfor$]{geometry}
$endif$
\usepackage{amsmath,amssymb}
$if(cancel)$
\usepackage{cancel}
$endif$
$--
$-- section numbering
$--
$if(numbersections)$
\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth$$else$5$endif$}
$else$
\setcounter{secnumdepth}{-\maxdimen} % remove section numbering
$endif$
$fonts.latex()$
$font-settings.latex()$
$common.latex()$
$for(header-includes)$
$header-includes$
$endfor$
$after-header-includes.latex()$
$hypersetup.latex()$
$if(pdf-trailer-id)$
\pdfvariable trailerid {[ $pdf-trailer-id$ ]}
$endif$

$if(title)$
\title{%
  \GuideTitle{$title$$if(thanks)$\thanks{$thanks$}$endif$}%
$if(subtitle)$
  \\[0.34in]%
  \GuideSubtitle{$subtitle$}%
$endif$
  \\[0.34in]%
  \GuideCoverRule
  \\[0.30in]%
  \GuideCoverRelease{$cover-release-label$}%
$if(cover-profile-label)$
  \\[0.12in]%
  \GuideCoverMeta{$cover-profile-label$}%
$endif$
}
$endif$
\author{\GuideCoverAuthor{$for(author)$$author$$sep$ \and $endfor$}}
\date{%
  \GuideCoverDate{$date$}%
  \\[0.38in]%
  \GuideCoverMeta{%
    $cover-identifier-label$: \texttt{v$document-version$}%
  }%
  \\[0.10in]%
  \GuideCoverMeta{%
    \href{https://github.com/M-Gage-Plott42/utc-hpc-guide}{%
      \textcolor{white}{github.com/M-Gage-Plott42/utc-hpc-guide}%
    }%
  }%
  \\[0.18in]%
  \parbox{0.86\textwidth}{\raggedright
    \GuideCoverMeta{%
      Canonical source: tracked repository chapters, site appendix,
      examples, and \texttt{pdf/guide\_manifest.json}.%
    }%
  }%
  \\[0.34in]%
  \parbox{0.86\textwidth}{\raggedright
    \GuideCoverMeta{%
      This guide is a practical baseline, not official cluster policy.
      Verify site-specific limits, software, storage, and access rules
      against current institutional documentation and live scheduler
      commands.%
    }%
  }%
}

\begin{document}
$if(has-frontmatter)$
\frontmatter
$endif$
$if(title)$
\hypersetup{pageanchor=false}
\pagenumbering{gobble}
\pagecolor{UTCNavy}
\thispdfpagelabel{Cover}
\maketitle
\nopagecolor
\hypersetup{pageanchor=true}
\pagenumbering{roman}
$if(abstract)$
\begin{abstract}
$abstract$
\end{abstract}
$endif$
$endif$

$for(include-before)$
$include-before$

$endfor$
$if(toc)$
$if(toc-title)$
\renewcommand*\contentsname{$toc-title$}
$endif$
{
$if(colorlinks)$
$if(toccolor)$
\hypersetup{linkcolor=$toccolor$}
$endif$
$endif$
\setcounter{tocdepth}{$toc-depth$}
\begin{multicols}{2}
\tableofcontents
\end{multicols}
}
\clearpage
\pagenumbering{arabic}
\thispagestyle{fancy}
$endif$
$if(lof)$
\listoffigures
$endif$
$if(lot)$
\listoftables
$endif$
$if(linestretch)$
\setstretch{$linestretch$}
$endif$
